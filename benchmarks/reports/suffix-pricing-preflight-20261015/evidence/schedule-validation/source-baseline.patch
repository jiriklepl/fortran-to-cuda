+def observed_schedule(stdout):
+    """Read the independently queried native or resident task's schedule ICV."""
+    matches = re.findall(r"^CPU_SCHEDULE ([^\n]+)$", stdout, re.MULTILINE)
+    try:
+        if len(matches) != 1:
