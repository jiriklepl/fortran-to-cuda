-                neighbor_sum += contrib.neighbor_sum;
-                coeff_center += contrib.coeff_center;
-            }
-
-            if (k < ns[2] - 1) {
-                auto top_idx = midx;
-                top_idx[2] += 1;
-                neighbor_sum += phi[FlatIndex(top_idx, ns)] * coeff_right_z;
-                coeff_center += coeff_right_z;
-            } else {
-                auto contrib = this->GetBorderContrib(phi,
-                                                      ns,
-                                                      midx,
-                                                      2,
-                                                      Side::Right,
-                                                      bcs[2].second,
