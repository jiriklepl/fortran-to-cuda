+"""Configured source preparation for the resident RK implementation.
+
+The application adapter owns the configured source and the RK lifetime. The
+compiler owns numerical extraction, dependence analysis and shared CUDA entry
+generation. There is no second buffer-validity or placement implementation here.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import subprocess
+from pathlib import Path
+
+
+def identity(path):
+    path = Path(path).resolve(strict=True)
+    return {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
+
+
+def configured_sources(paths, procedures, directory, *, fortran_compiler, defines):
+    """Expand configured includes and serialize selected numerical coordinators.
+
+    The original application is untouched. OpenMP is removed only in the selected
+    procedures of the generated variant: its kernels will be dispatched by the
+    serial resident coordinator. All statements, branches and arithmetic remain.
+    Numerical dependence checks subsequently run on that complete serial source.
+    This is not permission to execute uncovered native effects on stale buffers.
+    """
+    from fparser.common.readfortran import FortranStringReader
+    from fparser.two.parser import ParserFactory
+    from fparser.two.utils import walk
+
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    parser = ParserFactory().create(std="f2008")
+    selected = {name.lower() for name in procedures}
+    records = []
+    for filename in paths:
+        source = Path(filename).resolve(strict=True)
+        before = identity(source)
+        command = [str(fortran_compiler), "-cpp", "-E", "-P", "-O3", "-ffree-line-length-none", "-fopenmp",
+                   *("-D" + value for value in defines), "-I" + str(source.parent), str(source)]
+        result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
+        if result.returncode:
+            raise RuntimeError("RK preprocessing failed: " + str(source) + "\n" + result.stderr)
+        lines = result.stdout.splitlines(keepends=True)
+        tree = parser(FortranStringReader(result.stdout, ignore_comments=False))
+        removed = []
+        for module in (node for node in walk(tree) if type(node).__name__ == "Module"):
+            header = next(node for node in module.content if type(node).__name__ == "Module_Stmt")
+            module_name = str(header.items[1]).lower()
+            for routine in (node for node in walk(module) if type(node).__name__ == "Subroutine_Subprogram"):
+                statement = next(node for node in routine.content if type(node).__name__ == "Subroutine_Stmt")
+                name = module_name + "::" + str(statement.items[1]).lower()
+                if name not in selected:
+                    continue
+                ending = routine.content[-1]
+                first, last = statement.item.span[0], ending.item.span[1]
+                for index in range(first - 1, last):
+                    if re.match(r"\s*!\$omp\b", lines[index], re.I):
+                        removed.append({"line": index + 1, "directive": lines[index].rstrip(), "procedure": name})
+                        lines[index] = "\n"
+        target = directory / (hashlib.sha256(str(source).encode()).hexdigest()[:12] + "_" + source.name)
+        target.write_text("".join(lines))
+        if identity(source) != before:
+            raise ValueError("RK source changed while preparing: " + str(source))
+        records.append({"original": before, "prepared": identity(target), "command": command,
+                        "serialized_directives": removed})
+    record = {"version": 1, "kind": "configured_resident_rk_sources", "defines": list(defines),
+              "procedures": sorted(selected), "sources": records,
+              "execution_authorized": False,
+              "contract": "serial coordinator source; uncovered native effects need explicit coherence transactions"}
+    (directory / "configured-sources.json").write_text(json.dumps(record, indent=2) + "\n")
+    return record
+
+
+def generate_entries(extracted, compiler_root, python, directory):
+    from .local_adapter import transform
+
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    entries, rejected = [], list(extracted["rejected"])
+    for region in extracted["entries"]:
+        target = directory / region["source_identity"][:16]
+        try:
+            result = transform(Path(region["input_path"]), Path(compiler_root), Path(python), target,
+                               entry=region["entry"],
+                               gpu_options={"gpu_policy": "sections", "memory_model": "scoped",
+                                            "scope_transfers": "direct", "host_threads": 4})
+        except RuntimeError as error:
+            rejected.append({"procedure": region["procedure"], "first_line": region["first_line"],
+                             "last_line": region["last_line"], "reason": str(error)})
+            continue
+        execution = result["shared_entry"]["region_execution"]
+        unavailable = [item for item in execution if not item["gpu_available"]]
+        if unavailable:
+            rejected.append({"procedure": region["procedure"], "first_line": region["first_line"],
+                             "last_line": region["last_line"],
+                             "reason": "Resident GPU entry contains native-only regions", "regions": unavailable})
+            continue
+        entries.append({"region": region, "directory": str(target), "entry": result["shared_entry"]})
+    record = {"version": 1, "kind": "resident_rk_device_entries", "source_inputs": extracted["source_inputs"],
+              "entries": entries, "rejected": rejected, "gpu_execution_established": False}
+    (directory / "device-entries.json").write_text(json.dumps(record, indent=2) + "\n")
+    return record
+
+
+def value_resident_geometry(extracted, directory):
+    """Pass reached descriptor origins and validated grid geometry by VALUE.
+
+    Lower-bound actuals are evaluated by the caller after binding the reached
+    full allocation. Primary-grid counts and spacings are initialized before the
+    RK adapter is entered. Other scalars retain their guarded reference ABI.
+    VALUE is a language-level input contract, not a naming exemption in the
+    compiler's conditional-input analysis.
+    """
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    grid = {"parameters::" + name for name in ("dxmin", "dymin", "dzmin", "unx", "uny", "unz",
+            "vnx", "vny", "vnz", "wnx", "wny", "wnz")}
+    entries = []
+    for original in extracted["entries"]:
+        values = [p["name"] for p in original["parameters"]
+                  if p["lower_bound_dimension"] is not None or p["resource"] in grid]
+        text = Path(original["input_path"]).read_text()
+        for name in values:
+            pattern = r"(?im)^(integer|real\(8\)), intent\(in\) :: " + re.escape(name) + r"$"
+            text, count = re.subn(pattern, r"\1, value, intent(in) :: " + name, text)
+            if count != 1:
+                raise ValueError("Unexpected resident scalar declaration: " + name)
+        path = directory / Path(original["input_path"]).name
+        path.write_text(text)
+        entries.append({**original, "input_path": str(path), "value_inputs": values,
+                        "value_contract": "reached descriptor origins and initialized primary-grid geometry",
+                        "original_numerical_input": identity(original["input_path"])})
+    return {**extracted, "entries": entries}
+
+
+def verify_resident_execution(packages, trace, required_procedures):
+    """Require submitted GPU kernels, and reject observed generated-CPU work.
+
+    A generated CUDA file or a GPU placement request does not establish actual
+    execution. Match the runtime ledger to compiler-issued implementation IDs.
+    This check is for traced milestones, outside untraced performance runs.
+    """
+    from collections import Counter
+
+    implementations = {}
+    for package in packages:
+        for entry in package["entries"]:
+            for record in entry["entry"]["runtime_provenance"]["records"]:
+                if record["kind"] == "implementation":
+                    implementations[record["id"]] = (entry["region"]["procedure"], record["backend"])
+    kernels, native = Counter(), Counter()
+    for line in trace.splitlines():
+        event = re.match(r"FORT_SCOPED (\w+)", line)
+        identity = re.search(r" implementation=([a-f0-9]{64})\b", line)
+        if event is None or identity is None or identity[1] not in implementations:
+            continue
+        procedure, backend = implementations[identity[1]]
+        if backend == "generated_cpu":
+            native[procedure] += 1
+        elif backend == "cuda" and event[1] in {"launch", "graph_kernel"}:
+            kernels[procedure] += 1
+    if native:
+        raise ValueError("Resident entries executed on CPU: " + repr(dict(native)))
+    missing = sorted(set(required_procedures) - kernels.keys())
+    if missing:
+        raise ValueError("No GPU kernel execution recorded for: " + ", ".join(missing))
+    return {"gpu_kernels_by_procedure": dict(sorted(kernels.items())), "generated_cpu_events": dict(native),
+            "evidence": "runtime launch/graph-kernel ledger matched to compiler implementation identities"}
+
+
+def guard_periodic_entries(extracted, directory):
+    """Keep halo copies independent under the adapter's three-cell minimum.
+
+    The added predicate is also a reached-call guard. Small grids use the native
+    implementation. The compiler proves these integer predicates rather than
+    accepting an assertion that a potentially overlapping copy is independent.
+    """
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    entries = []
+    for original in extracted["entries"]:
+        if original["procedure"] != "boundaries::periodic_corners_edges":
+            continue
+        source = Path(original["input_path"]).read_text()
+        assignments = list(re.finditer(r"(?im)^([ \t]*)u\(", source))
+        if len(assignments) != len(original["source_loop_spans"]):
+            raise ValueError("Periodic corner entry must have one assignment per original nest")
+        guard = "nx >= 3 .and. ny >= 3 .and. nz >= 3"
+        prepared = source
+        for assignment in reversed(assignments):
+            end = re.search(r"(?im)^[ \t]*end do\b", source[assignment.start():])
+            if end is None:
+                raise ValueError("Periodic corner entry has no enclosing point loop")
+            stop = assignment.start() + end.start()
+            prepared = (prepared[:assignment.start()] + "      if (" + guard + ") then\n"
+                        + prepared[assignment.start():stop] + "      endif\n" + prepared[stop:])
+        path = directory / Path(original["input_path"]).name
+        path.write_text(prepared)
+        entries.append({**original, "input_path": str(path),
+                        "runtime_guards": [*original["runtime_guards"], guard],
+                        "adapter_guard": {"condition": guard, "original": identity(original["input_path"]),
+                                          "prepared": identity(path), "false_path": "original native procedure"}})
+    return {**extracted, "entries": entries, "rejected": []}
+
+
+def _native_wall_correction(body):
+    """Retain the original correction with conservative, bounded host access.
+
+    This adapter covers the original second-order no-branch correction includes.
+    Their stencil radius is at most two around the named wall-point coordinates.
+    Empty point sets evaluate no field descriptor or coordinate reduction.
+    """
+    points = set(re.findall(r"\b([UVW][xyz][mp]WMpoints)\s*\(i\)\s*%", body, re.I))
+    writes = set(re.findall(r"(?im)^\s*([UVW]2)\s*\([^\n]*", body))
+    if len(points) != 1 or len(writes) != 1:
+        raise ValueError("Unknown native wall-correction body")
+    points, target = next(iter(points)), next(iter(writes))
+    fields = [target, target[0], "nu"]
+    lines = ["    block", "      use, intrinsic :: iso_c_binding",
+             "      use elmm_resident_pressure_state, only: resident_flow",
+             "      integer(c_int64_t) :: wall_handles(3)", "      integer :: wall_first(3),wall_last(3),wall_index",
+             "      wall_handles=0", "      if (resident_flow%active) then", "        if (size(" + points + ")>0) then",
+             "          wall_first=[" + ",".join("minval(" + points + "%" + axis + ")" for axis in ("xi", "yj", "zk")) + "]-2",
+             "          wall_last=[" + ",".join("maxval(" + points + "%" + axis + ")" for axis in ("xi", "yj", "zk")) + "]+2"]
+    for index, field in enumerate(fields, 1):
+        lines.append(f"          wall_handles({index})=resident_flow%host_box_real64({field},lbound({field}), &")
+        lines.append("            wall_first,wall_last," + (".true." if index == 1 else ".false.") + ")")
+    lines += ["        endif", "      endif", body.rstrip(),
+              "      do wall_index=1,3", "        if (wall_handles(wall_index)/=0) call resident_flow%host_end(wall_handles(wall_index))",
+              "      enddo", "    end block"]
+    return "\n".join(lines) + "\n"
+
+
+def materialize_entries(packages, directory):
+    """Replace proved numerical spans and preserve explicit native boundaries.
+
+    Activation belongs to the outer RK adapter. Every unsupported reached loop
+    publishes before native execution; the wall-point adapter uses smaller exact
+    geometric supersets. This function never infers effects for other calls.
+    """
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    edits, expected = {}, {}
+    for package in packages:
+        expected.update(package["source_inputs"])
+        for item in package["entries"]:
+            region, entry = item["region"], item["entry"]
+            bindings = {binding["resource"]: binding for binding in region["resources"]}
+            actual, registration, handles = {}, [], []
+            for parameter in region["parameters"]:
+                binding = bindings[parameter["resource"]]
+                name = binding["name"]
+                if parameter["lower_bound_dimension"] is not None:
+                    actual[parameter["name"]] = f"lbound({name},{parameter['lower_bound_dimension']})"
+                elif parameter["rank"]:
+                    handle = "rk_handle_" + parameter["name"]
+                    actual[parameter["name"]] = handle
+                    method = {("real", 8): "bind_real64", ("integer", 4): "bind_integer32"}.get((binding["type"], binding["kind"]))
+                    if method is None:
+                        raise ValueError("Unsupported resident array ABI: " + str(binding))
+                    handles.append(handle)
+                    registration.append(f"        {handle}=resident_flow%{method}({name},lbound({name}),.true.)")
+                else:
+                    actual[parameter["name"]] = name
+            arguments = ["resident_flow%context", "FORT_SCOPE_GPU"] + [actual[name] for name in entry["argument_order"][2:]]
+            code = ["    block", "      use, intrinsic :: iso_c_binding",
+                    "      use fort_scoped_memory, only: FORT_SCOPE_GPU",
+                    "      use elmm_resident_pressure_state, only: resident_flow, pressure_require",
+                    "      use " + entry["fortran_module"] + ", only: rk_device_run => run",
+                    "      integer(c_int64_t) :: " + ",".join(handles),
+                    "      if (resident_flow%active) then"]
+            for guard in region["runtime_guards"]:
+                code.append("        if (.not. (" + guard + ")) error stop 'resident numerical geometry changed'")
+            code += registration + ["        call pressure_require(rk_device_run( &", "          " + ", &\n          ".join(arguments) + "))",
+                                    "      else", "@ORIGINAL@", "      endif", "    end block"]
+            edits.setdefault(region["source"], []).append((region["first_line"], region["last_line"], "\n".join(code) + "\n"))
+        for region in package["rejected"]:
+            # Extraction rejections carry procedure identity; find that source
+            # in successful entries from the same procedure, when available.
+            sources = {entry["region"]["source"] for entry in package["entries"]
+                       if entry["region"]["procedure"] == region["procedure"]}
+            if not sources:
+                continue  # Entirely native routine; outer call boundary owns it.
+            if len(sources) != 1:
+                raise ValueError("Ambiguous resident native source")
+            source = next(iter(sources))
+            wall = region["procedure"] == "momentumdiffusion::momentumdiffusion_nobranch_2ord"
+            code = "@WALL@" if wall else ("    block\n      use elmm_resident_pressure_state, only: resident_flow\n"
+                    "      if (resident_flow%active) call resident_flow%publish()\n@ORIGINAL@\n    end block\n")
+            edits.setdefault(source, []).append((region["first_line"], region["last_line"], code))
+    records = []
+    for source, replacements in edits.items():
+        path = Path(source)
+        if identity(path)["sha256"] != expected[source]:
+            raise ValueError("Resident numerical source changed: " + source)
+        lines = path.read_text().splitlines(keepends=True)
+        replacements.sort()
+        if any(a[1] >= b[0] for a, b in zip(replacements, replacements[1:])):
+            raise ValueError("Overlapping resident source replacements")
+        for first, last, code in reversed(replacements):
+            original = "".join(lines[first - 1:last])
+            replacement = _native_wall_correction(original) if code == "@WALL@" else code.replace("@ORIGINAL@", original.rstrip())
+            lines[first - 1:last] = [replacement]
+        target = directory / path.name
+        target.write_text("".join(lines))
+        records.append({"original": identity(path), "replacement": identity(target), "region_count": len(replacements)})
+    result = {"version": 1, "kind": "resident_rk_numerical_source_edits", "sources": records,
+              "activation_authority": "outer RK adapter; native call effects are not inferred here"}
+    (directory / "source-edits.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def pointwise_advection(source, directory):
+    """Inline ELMM's private tile flux arrays into their original consumers.
+
+    Read formulas from the source. Each private flux has one point definition;
+    a consumer offset selects that definition at the corresponding global point.
+    Keep the three directional updates and their original arithmetic order.
+    This removes CPU cache tiles, without changing the advection discretization.
+    """
+    from fparser.common.readfortran import FortranStringReader
+    from fparser.two.parser import ParserFactory
+    from fparser.two.utils import walk
+
+    source = Path(source).resolve(strict=True)
+    text = source.read_text()
+    lines = text.splitlines(keepends=True)
+    tree = ParserFactory().create(std="f2008")(FortranStringReader(text, ignore_comments=False))
+    changes = []
+
+    def statements(node):
+        return [item for item in node.content if type(item).__name__ not in {"Comment", "Nonlabel_Do_Stmt", "End_Do_Stmt"}]
+
+    def inner(loop, variable):
+        header = next(item for item in loop.content if type(item).__name__ == "Nonlabel_Do_Stmt")
+        if str(header.items[1].items[1][0]).lower() != variable:
+            raise ValueError("Unexpected advection tile iterator")
+        children = statements(loop)
+        if len(children) != 1 or type(children[0]).__name__ != "Block_Nonlabel_Do_Construct":
+            raise ValueError("Unexpected advection tile nesting")
+        return children[0]
+
+    def shift(expression, offsets):
+        return re.sub(r"\b[ijk]\b", lambda match: "(" + match[0] + "+(" + str(offsets["ijk".index(match[0].lower())]) + "))", expression, flags=re.I)
+
+    for routine in (node for node in walk(tree) if type(node).__name__ == "Subroutine_Subprogram"):
+        header = next(node for node in routine.content if type(node).__name__ == "Subroutine_Stmt")
+        name = str(header.items[1]).lower()
+        if name not in {"cd4divu", "cd4divv", "cd4divw"}:
+            continue
+        component = name[-1].upper()
+        mask = next((node for node in walk(routine) if type(node).__name__ == "Type_Declaration_Stmt"
+                     and re.search(r"\bi_mask4\b", str(node), re.I)), None)
+        if mask is None or "[-1,9,9,-1]" not in re.sub(r"\s+", "", str(mask)).lower():
+            raise ValueError("Unsupported fourth-order interpolation mask")
+        execution = next(node for node in routine.content if type(node).__name__ == "Execution_Part")
+        tiles = [node for node in execution.content if type(node).__name__ == "Block_Nonlabel_Do_Construct"]
+        if len(tiles) != 3:
+            raise ValueError("Expected three directional advection tiles")
+        for tile in tiles:
+            bi = inner(inner(tile, "bk"), "bj")
+            pair = statements(bi)
+            if len(pair) != 2 or any(type(node).__name__ != "Block_Nonlabel_Do_Construct" for node in pair):
+                raise ValueError("Advection tile must have one producer and one consumer nest")
+            producer, consumer = pair
+            producer_leaf = inner(inner(producer, "k"), "j")
+            consumer_leaf = inner(inner(consumer, "k"), "j")
+            definitions = {}
+            for statement in statements(producer_leaf):
+                if type(statement).__name__ != "Assignment_Stmt":
+                    raise ValueError("Advection flux producer is not straight-line arithmetic")
+                lhs, _, rhs = statement.items
+                key = str(lhs).replace(" ", "").lower()
+                if key in {"li", "lj", "lk"}:
+                    continue
+                expression = str(rhs)
+                for local, value in definitions.items():
+                    if "(" not in local:
+                        expression = re.sub(r"\b" + re.escape(local) + r"\b", "(" + value + ")", expression, flags=re.I)
+                definitions[key] = expression
+            if set(key for key in definitions if "(" in key) != {"uv1(li,lj,lk)", "uv3(li,lj,lk)"}:
+                raise ValueError("Advection producer has unexpected scratch storage")
+            body = []
+            for statement in statements(consumer_leaf):
+                if type(statement).__name__ == "Assignment_Stmt" and str(statement.items[0]).lower() in {"li", "lj", "lk"}:
+                    continue
+                rendered = str(statement)
+                for reference in reversed(list(walk(statement))):
+                    if type(reference).__name__ != "Part_Ref" or str(reference.items[0]).lower() not in {"uv1", "uv3"}:
+                        continue
+                    offsets = []
+                    for axis, index in zip(("li", "lj", "lk"), reference.items[1].items, strict=True):
+                        match = re.fullmatch(axis + r"(?:([+-])(\d+))?", re.sub(r"\s+", "", str(index)).lower())
+                        if match is None:
+                            raise ValueError("Nonconstant advection scratch offset")
+                        offsets.append(0 if match[1] is None else int(match[1] + match[2]))
+                    value = definitions[str(reference.items[0]).lower() + "(li,lj,lk)"]
+                    rendered = rendered.replace(str(reference), "(" + shift(value, offsets) + ")")
+                body.append(rendered)
+            replacement = (f"    do k=1,{component}nz\n      do j=1,{component}ny\n        do i=1,{component}nx\n"
+                           + "\n".join(body) + "\n        enddo\n      enddo\n    enddo\n")
+            first = next(node for node in tile.content if type(node).__name__ == "Nonlabel_Do_Stmt").item.span[0]
+            last = tile.content[-1].item.span[1]
+            changes.append((first, last, replacement))
+    if len(changes) != 9:
+        raise ValueError("Incomplete fourth-order advection preparation")
+    for first, last, replacement in sorted(changes, reverse=True):
+        lines[first-1:last] = [replacement]
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    target = directory / source.name
+    target.write_text("".join(lines))
+    record = {"version": 1, "kind": "pointwise_advection", "original": identity(source), "replacement": identity(target),
+              "directional_updates": len(changes), "formula_source": "original private flux definitions and consumer expressions"}
+    (directory / "pointwise-advection.json").write_text(json.dumps(record, indent=2) + "\n")
+    return record
+
+
+def snapshot_filter(source, directory):
+    """Lift each line snapshot to a complete snapshot for pointwise filtering.
+
+    The original filter reads a private copy of each input line before writing
+    that line. A complete input snapshot preserves those reads and the original
+    seven-term accumulation order while exposing independent output points.
+    Retire the temporary through coherence before Fortran deallocates it.
+    """
+    from .gpu_hot_path import _once, _routine
+
+    source = Path(source).resolve(strict=True)
+    text = source.read_text()
+    lo, hi = _routine(text, "Filter3ord")
+    body = text[lo:hi]
+    declaration = "    real(knd) :: tmp(-2:ubound(U,dir))"
+    _once(body, declaration)
+    body = body.replace(declaration, "    real(knd), allocatable :: tmp(:,:,:)\n")
+    anchor = "    mini = lbound(U,1) + 3"
+    _once(body, anchor)
+    body = body.replace(anchor, "    allocate(tmp(-2:ubound(U,1),-2:ubound(U,2),-2:ubound(U,3)))\n"
+                        "    do k=-2,ubound(U,3)\n      do j=-2,ubound(U,2)\n        do i=-2,ubound(U,1)\n"
+                        "          tmp(i,j,k)=U(i,j,k)\n        enddo\n      enddo\n    enddo\n\n" + anchor)
+    for assignment in ("tmp = U(:,j,k)", "tmp = U(i,:,k)", "tmp = U(i,j,:)"):
+        _once(body, assignment)
+        body = body.replace(assignment, "! Input line is in the complete snapshot.")
+    for index, coordinates in (("ii", "ii,j,k"), ("jj", "i,jj,k"), ("kk", "i,j,kk")):
+        _once(body, "tmp(" + index + ")")
+        body = body.replace("tmp(" + index + ")", "tmp(" + coordinates + ")")
+    # Express the seven fixed stencil offsets directly. The compiler can then
+    # lower the small private weight array without a variable indexing loop.
+    for axis, index in (("i", "ii"), ("j", "jj"), ("k", "kk")):
+        loop = re.search(r"(?im)^\s*do " + index + r" = " + axis + r"-3, " + axis + r"\+3\b.*?^\s*end do\b",
+                         body, re.S)
+        if loop is None:
+            raise ValueError("Missing original seven-point filter accumulation")
+        original = loop[0]
+        shifted = re.sub(r"\b" + index + r"\b", "(" + axis + "+" + index + ")", original)
+        shifted = shifted.replace("(" + axis + "+" + index + ")-" + axis, index)
+        shifted = shifted.replace("do (" + axis + "+" + index + ") = " + axis + "-3, " + axis + "+3",
+                                  "do " + index + " = -3, 3")
+        body = body[:loop.start()] + shifted + body[loop.end():]
+    ending = re.search(r"(?im)^\s*end subroutine Filter3ord", body)
+    if ending is None:
+        raise ValueError("Missing filter procedure end")
+    body = body[:ending.start()] + ("\n    block\n      use elmm_resident_pressure_state, only: resident_flow\n"
+            "      call resident_flow%release_real64(tmp)\n    end block\n") + body[ending.start():]
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    target = directory / source.name
+    target.write_text(text[:lo] + body + text[hi:])
+    record = {"version": 1, "kind": "snapshot_filter", "original": identity(source), "replacement": identity(target),
+              "arithmetic": "original Filter3ord weights, conditions and accumulation order",
+              "lifetime": "retire snapshot after queued readers before automatic deallocation"}
+    (directory / "snapshot-filter.json").write_text(json.dumps(record, indent=2) + "\n")
+    return record
+
+
+def addressable_arrays(text):
+    """Give borrowed primitive allocations and dummy arrays stable C addresses."""
+    from fparser.common.readfortran import FortranStringReader
+    from fparser.two.parser import ParserFactory
+    from fparser.two.utils import walk
+
+    tree = ParserFactory().create(std="f2008")(FortranStringReader(text, ignore_comments=False))
+    lines = text.splitlines(keepends=True)
+    changes = []
+    for node in walk(tree):
+        if type(node).__name__ != "Type_Declaration_Stmt":
+            continue
+        dtype, attributes, entities = node.items
+        attrs = str(attributes).lower()
+        if not re.match(r"(?i)^(real|integer|logical)\b", str(dtype)) or re.search(r"\b(target|parameter|pointer)\b", attrs):
+            continue
+        is_array = "dimension" in attrs or any(entity.items[1] is not None for entity in entities.items)
+        parent = node.parent
+        while parent is not None and type(parent).__name__ not in {"Module", "Subroutine_Subprogram", "Function_Subprogram", "Derived_Type_Def", "Main_Program"}:
+            parent = getattr(parent, "parent", None)
+        if not is_array or parent is None or type(parent).__name__ == "Derived_Type_Def":
+            continue
+        if type(parent).__name__ not in {"Module", "Main_Program"} and "intent" not in attrs and "allocatable" not in attrs:
+            continue
+        first, last = node.item.span
+        declaration = str(node)
+        before, after = declaration.split("::", 1)
+        changes.append((first, last, before.rstrip() + ", TARGET ::" + after + "\n"))
+    for first, last, replacement in sorted(changes, reverse=True):
+        lines[first-1:last] = [replacement]
+    return "".join(lines)
+
+
+def integrate_rk_epoch(configured, numerical, pressure, directory):
+    """Connect the compiled primary RK path and the pressure child to one epoch.
+
+    Uniform DP, Sigma SGS, explicit FD2 diffusion and periodic/no-slip channel
+    boundaries are the initial supported execution configuration. Other settings
+    retain their native path. Physical allocations survive the proved three
+    MOVE_ALLOC exchanges; the RK caller return publishes before unmanaged work.
+    """
+    from .gpu_hot_path import _once, _routine
+
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    replacements = {item["original"]["path"]: item["replacement"]["path"] for item in numerical["sources"]}
+    sources = {Path(item["original"]["path"]).name: Path(replacements.get(item["prepared"]["path"], item["prepared"]["path"]))
+               for item in configured["sources"] if "/elmm/src/" in item["original"]["path"]}
+    # Only modules whose numerical code or address contracts are changed need
+    # rebuilding. No source graph owner or legacy placement wrapper is retained.
+    names = {"parameters.f90", "arrayutilities.f90", "subgrid.f90", "dynamics.f90", "momentum_diffusion.f90",
+             "advection.f90", "scalarboundaries.f90", "boundaries.f90", "tsteps.f90", "linearforcing.f90",
+             "volumesources.f90", "sponge.f90", "tiling.f90", "filters.f90", "wallmodels.f90",
+             "advection_variable_z.f90", "water_thermodynamics.f90", "scalar_diffusion.f90"}
+    output = {name: sources[name].read_text() for name in names}
+    output["pressure.f90"] = Path(pressure["pressure"]["path"]).read_text()
+    output["main.f90"] = Path(pressure["main"]["path"]).read_text()
+
+    arrays = output["arrayutilities.f90"]
+    begin = re.search(r"(?im)^\s*subroutine set_int_3D\(", arrays)
+    if begin is None:
+        raise ValueError("Missing integer-valued REAL64 fill overload")
+    end = re.search(r"(?im)^\s*end subroutine[^\n]*", arrays[begin.start():])
+    stop = begin.start() + end.end()
+    # Conversion is scalar and exact under the original assignment rules. One
+    # implementation owns the fill, including ordering against queued readers.
+    arrays = arrays[:begin.start()] + '''
+    subroutine set_int_3D(to,from)
+      real(knd),contiguous,intent(out) :: to(:,:,:)
+      integer,intent(in) :: from
+      call set_3D(to,real(from,knd))
+    end subroutine
+''' + arrays[stop:]
+    output["arrayutilities.f90"] = arrays
+
+    def at_once(text, anchor, addition, after=False):
+        position = _once(text, anchor) + (len(anchor) if after else 0)
+        return text[:position] + addition + text[position:]
+
+    def publish_block(indent="    "):
+        return (indent + "block\n" + indent + "  use elmm_resident_pressure_state, only: resident_flow\n"
+                + indent + "  if (resident_flow%active) call resident_flow%publish()\n" + indent + "end block\n")
+
+    tsteps = output["tsteps.f90"]
+    lo, hi = _routine(tsteps, "TMarchRK3")
+    body = tsteps[lo:hi]
+    body = at_once(body, "    use RungeKutta_coefficients\n", "    use, intrinsic :: iso_c_binding\n"
+                   "    use elmm_resident_pressure_state, only: resident_flow\n", after=True)
+    body = at_once(body, "      call SubgridStresses(U, V, W, Pr, Temperature, Moisture)",
+                   "      if (.not. resident_flow%joined) then\n"
+                   "        if (ResidentRKSupported()) then\n"
+                   "          call resident_flow%begin_epoch(0_c_int,2147483648_c_size_t)\n"
+                   "          resident_flow%joined=.true.\n        endif\n      endif\n\n")
+    end = body.rfind("    end do")
+    if end < 0:
+        raise ValueError("Missing RK stage loop")
+    end += len("    end do")
+    body = body[:end] + ("\n    if (resident_flow%joined) then\n"
+                         "      call resident_flow%end_epoch()\n      resident_flow%joined=.false.\n    endif\n") + body[end:]
+    tsteps = tsteps[:lo] + body + tsteps[hi:]
+    lo, hi = _routine(tsteps, "IBMassSources")
+    body = tsteps[lo:hi]
+    # In the configured serial application an empty point set leaves the
+    # complete Q allocation at +0. Bound_Q only adds those zero halo values.
+    # Keep the reached GPU fill and avoid constructing a false host consumer.
+    _once(body, "    call set(Q, 0)")
+    body = body.replace("    call set(Q, 0)", "    call set(Q, 0._knd)\n"
+                        "    if (size(Up)+size(Vp)+size(Wp)==0) return\n" + publish_block())
+    tsteps = tsteps[:lo] + body + tsteps[hi:]
+    # These unported immersed-boundary operations are reached only when their
+    # point arrays contain work. Empty primary-channel paths keep all replicas.
+    tsteps = at_once(tsteps, "    if (size(Up) + size(Vp) + size(Wp)>0) then\n", publish_block("      "), after=True)
+    lo, hi = _routine(tsteps, "NullInterior")
+    body = tsteps[lo:hi]
+    body = at_once(body, "    !$omp parallel private(i)",
+                   "    if (nUnull+nVnull+nWnull>0) then\n" + publish_block("      ") + "    endif\n")
+    tsteps = tsteps[:lo] + body + tsteps[hi:]
+    supported = '''
+  logical function ResidentRKSupported() result(supported)
+    use Subgrid, only: sgstype, SigmaModel
+    use Filters, only: filtertype
+    use ImmersedBoundary, only: ScalFlIBPoints
+    supported = gridtype==GRID_UNIFORM .and. explicit_diffusion .and. discretization_order==2
+    supported = supported .and. sgstype==SigmaModel .and. (filtertype==0 .or. filtertype==1)
+    supported = supported .and. (advection_method==2 .or. advection_method==4 .or. advection_method==5 .or. advection_method==6)
+    supported = supported .and. min(Unx,Uny,Unz,Vnx,Vny,Vnz,Wnx,Wny,Wnz)>=3
+    supported = supported .and. all(Btype([We,Ea,So,No])==BC_PERIODIC) .and. all(Btype([Bo,To])==BC_NOSLIP)
+    supported = supported .and. .not. enable_buoyancy .and. .not. enable_moisture .and. .not. enable_liquid
+    supported = supported .and. num_of_scalars==0 .and. abs(Coriolis_parameter)<=tiny(1._knd)
+    supported = supported .and. .not. enable_top_sponge .and. .not. enable_out_sponge_x .and. .not. enable_out_sponge_y
+    supported = supported .and. .not. enable_fixed_flow_rate
+    supported = supported .and. debuglevel==0 .and. steady/=1 .and. size(ScalFlIBPoints)==0
+    supported = supported .and. .not. pressure_solution%check_divergence
+    supported = supported .and. .not. any(pressure_solution%correct_mass_flux)
+  end function
+'''
+    end = re.search(r"(?im)^\s*end module TimeSteps\b", tsteps)
+    if end is None:
+        raise ValueError("Missing timestep module end")
+    output["tsteps.f90"] = tsteps[:end.start()] + supported + tsteps[end.start():]
+
+    dynamics = output["dynamics.f90"]
+    lo, hi = _routine(dynamics, "Convection")
+    body = dynamics[lo:hi]
+    body = at_once(body, "  contains", "    block\n      use elmm_resident_pressure_state, only: resident_flow\n"
+                   "      call resident_flow%release_real64(beta)\n      call resident_flow%release_real64(rho)\n    end block\n\n")
+    output["dynamics.f90"] = dynamics[:lo] + body + dynamics[hi:]
+
+    dynamics = output["dynamics.f90"]
+    lo, hi = _routine(dynamics, "SubgridStresses")
+    body = dynamics[lo:hi]
+    # Wall-model records still live on the host. Their field inputs are reads:
+    # observing the current allocation must preserve every device replica.
+    # The optional pressure gradient is read only by wall model 2. The primary
+    # configurations exclude thermal/moisture fields through the RK guard.
+    wall_observation = '''    block
+      use, intrinsic :: iso_c_binding
+      use elmm_resident_pressure_state, only: resident_flow
+      integer(c_int64_t) :: wall_reads(4)
+      integer :: wall_count
+      if (resident_flow%active .and. wallmodeltype>0) then
+        wall_reads(1)=resident_flow%bind_real64(U,lbound(U),.true.)
+        wall_reads(2)=resident_flow%bind_real64(V,lbound(V),.true.)
+        wall_reads(3)=resident_flow%bind_real64(W,lbound(W),.true.)
+        wall_count=3
+        if (wallmodeltype==2) then
+          wall_reads(4)=resident_flow%bind_real64(Pr,lbound(Pr),.true.)
+          wall_count=4
+        endif
+        call resident_flow%observe(wall_reads(:wall_count))
+      endif
+    end block
+
+'''
+    first_wall = body.index("    if (wallmodeltype>0) then")
+    body = body[:first_wall] + wall_observation + body[first_wall:]
+    original = "                      call ComputeViscsWM(U,V,W,Pr,Temperature,Moisture)"
+    _once(body, original)
+    body = body.replace(original, '''      block
+        use, intrinsic :: iso_c_binding
+        use elmm_resident_pressure_state, only: resident_flow
+        integer(c_int64_t) :: wall_write
+        wall_write=0
+        if (resident_flow%active) then
+          if (size(WMPoints)>0) then
+            wall_write=resident_flow%host_box_real64(Viscosity,lbound(Viscosity), &
+              [minval(WMPoints%xi),minval(WMPoints%yj),minval(WMPoints%zk)], &
+              [maxval(WMPoints%xi),maxval(WMPoints%yj),maxval(WMPoints%zk)],.true.)
+          endif
+        endif
+        call ComputeViscsWM(U,V,W,Pr,Temperature,Moisture)
+        if (wall_write/=0) call resident_flow%host_end(wall_write)
+      end block''')
+    output["dynamics.f90"] = dynamics[:lo] + body + dynamics[hi:]
+
+    # Optional forcing keeps its existing condition and native implementation.
+    # Enter coherence only when it actually has work; these calls are empty in
+    # both primary channel configurations.
+    linear = output["linearforcing.f90"]
+    start = re.search(r"(?im)^\s*subroutine\s+linear_forcing\(", linear).start()
+    before, body = linear[:start], linear[start:]
+    body = at_once(body, "    if (enable_linear_forcing) then\n", publish_block("      "), after=True)
+    output["linearforcing.f90"] = before + body
+    volumes = output["volumesources.f90"]
+    lo, hi = _routine(volumes, "ResistanceForce")
+    body = volumes[lo:hi]
+    body = at_once(body, "           if (allocated(src)) then\n",
+                   "             if (size(src)>0) then\n" + publish_block("               ") + "             endif\n", after=True)
+    output["volumesources.f90"] = volumes[:lo] + body + volumes[hi:]
+    sponge = output["sponge.f90"]
+    anchor = "    if (enable_top_rayleigh_damping) call rayleigh_damping_top_uvw(U2, V2, W2, U, V, W)"
+    _once(sponge, anchor)
+    output["sponge.f90"] = sponge.replace(anchor, "    if (enable_top_rayleigh_damping) then\n" + publish_block("      ")
+                                          + "      call rayleigh_damping_top_uvw(U2, V2, W2, U, V, W)\n    endif")
+
+    records = []
+    for name, text in output.items():
+        target = directory / name
+        target.write_text(addressable_arrays(text))
+        records.append(identity(target))
+    record = {"version": 1, "kind": "resident_rk_epoch_integration", "sources": records,
+              "epoch": "all reached RK stages in one invocation; pressure borrows caller domain",
+              "allocation_exchange": "original exchange_alloc_3D: A->tmp, B->A, tmp->B with MOVE_ALLOC",
+              "unmanaged_return": "batch observe then retire borrowed handles at RK caller return",
+              "gpu_execution_established": False}
+    (directory / "rk-integration.json").write_text(json.dumps(record, indent=2) + "\n")
+    return record
diff --git a/elmm_pipeline/resident_time_loop.py b/elmm_pipeline/resident_time_loop.py
new file mode 100644
index 0000000000000000000000000000000000000000..0c611101f5a5e547761702e701909437ab2fef58
--- /dev/null
+++ b/elmm_pipeline/resident_time_loop.py
@@ -0,0 +1,246 @@
+"""Checked primary-channel timestep lifetime and numerical source preparation.
+
+This adapter owns the ELMM control region, not coherence. Ordinary compiler
+entries implement the per-cell arithmetic; the generic runtime reduces CFL.
+Unsupported output work closes the epoch before executing its original source.
+Primary VTK output uses bounded immutable snapshots and joins before teardown.
+"""
+from pathlib import Path
+import json
+import re
+
+from .gpu_hot_path import _once, _routine
+from .resident_rk import addressable_arrays, identity
+
+
+def generate_time_entries(compiler_root, python, directory):
+    from .local_adapter import transform
+
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    sources = {
+        "cfl": """module resident_cfl_source
+implicit none
+contains
+subroutine values(u,v,w,cfl,nx,ny,nz,dx,dy,dz)
+real(8), intent(in) :: u(:,:,:),v(:,:,:),w(:,:,:)
+real(8), intent(out) :: cfl(:,:,:)
+integer, value, intent(in) :: nx,ny,nz
+real(8), value, intent(in) :: dx,dy,dz
+integer :: i,j,k
+real(8) :: p
+do k=1,nz
+ do j=1,ny
+  do i=1,nx
+   p = max(abs(u(i+3,j+3,k+3)),abs(u(i+2,j+3,k+3))) / dx
+   p = p + max(abs(v(i+3,j+3,k+3)),abs(v(i+3,j+2,k+3))) / dy
+   p = p + max(abs(w(i+3,j+3,k+3)),abs(w(i+3,j+3,k+2))) / dz
+   cfl(i,j,k)=p
+  enddo
+ enddo
+enddo
+end subroutine
+end module
+""",
+        "average": """module resident_average_source
+implicit none
+contains
+subroutine accumulate(source,average,nx,ny,nz,ox,oy,oz,weight)
+real(8), intent(in) :: source(:,:,:)
+real(8), intent(inout) :: average(:,:,:)
+integer, value, intent(in) :: nx,ny,nz,ox,oy,oz
+real(8), value, intent(in) :: weight
+integer :: i,j,k
+do k=1,nz
+ do j=1,ny
+  do i=1,nx
+   average(i,j,k)=average(i,j,k)+source(i+ox,j+oy,k+oz)*weight
+  enddo
+ enddo
+enddo
+end subroutine
+end module
+"""}
+    result = {"version": 1, "entries": {}}
+    for name, text in sources.items():
+        source = directory / (name + ".f90")
+        source.write_text(text)
+        entry = "resident_cfl_source::values" if name == "cfl" else "resident_average_source::accumulate"
+        target = directory / (name + "-entry")
+        transformed = transform(source, Path(compiler_root), Path(python), target, entry=entry,
+                                gpu_options={"gpu_policy": "sections", "memory_model": "scoped",
+                                             "scope_transfers": "direct", "host_threads": 4})
+        shared = transformed["shared_entry"]
+        if not shared["region_execution"] or not all(r["gpu_available"] for r in shared["region_execution"]):
+            raise ValueError("Timestep numerical entry lacks GPU execution: " + name)
+        result["entries"][name] = {"source": identity(source), "directory": str(target), "entry": shared}
+    (directory / "time-entries.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def _tasks(entries):
+    cfl, avg = (entries["entries"][n]["entry"] for n in ("cfl", "average"))
+    def invoke(entry, arguments):
+        values = ["resident_flow%context", "FORT_SCOPE_GPU"] + [arguments[n] for n in entry["argument_order"][2:]]
+        return "call pressure_require(" + ("cfl_run" if entry is cfl else "average_run") + "( &\n      " + ", &\n      ".join(values) + "))"
+    cfl_call = invoke(cfl, dict(u="handles(1)", v="handles(2)", w="handles(3)", cfl="handle",
+                                nx="nx", ny="ny", nz="nz", dx="dx", dy="dy", dz="dz"))
+    avg_call = invoke(avg, dict(source="source_handle", average="average_handle", nx="size(average,1)",
+                                ny="size(average,2)", nz="size(average,3)", ox="offset(1)",
+                                oy="offset(2)", oz="offset(3)", weight="weight"))
+    return f"""module elmm_resident_time_tasks
+  use, intrinsic :: iso_c_binding
+  use fort_scoped_memory
+  use fort_resident_reductions
+  use elmm_resident_pressure_state, only: resident_flow, pressure_require
+  use {cfl['fortran_module']}, only: cfl_run=>run
+  use {avg['fortran_module']}, only: average_run=>run
+  implicit none
+  private
+  public :: ResidentCFL, ResidentAverage
+  real(c_double), allocatable, target, save :: cfl_values(:,:,:)
+contains
+  subroutine ResidentCFL(U,V,W,nx,ny,nz,dx,dy,dz,maximum,nan)
+    real(c_double), contiguous, target, intent(in) :: U(:,:,:),V(:,:,:),W(:,:,:)
+    integer, intent(in) :: nx,ny,nz
+    real(c_double), intent(in) :: dx,dy,dz
+    real(c_double), intent(out) :: maximum
+    logical, intent(out) :: nan
+    integer(c_int64_t) :: handles(3),handle
+    integer(c_int32_t) :: any_nan
+    type(fort_scope_external_report_v1) :: report
+    if (min(nx,ny,nz)<1) error stop 'invalid CFL grid'
+    if (.not.allocated(cfl_values)) allocate(cfl_values(nx,ny,nz))
+    if (any(shape(cfl_values)/=[nx,ny,nz])) error stop 'CFL storage epoch shape changed'
+    if (any(shape(U)<[nx,ny,nz]+3) .or. any(shape(V)<[nx,ny,nz]+3) .or. &
+        any(shape(W)<[nx,ny,nz]+3)) error stop 'CFL velocity geometry changed'
+    handles(1)=resident_flow%bind_real64(U,[-2,-2,-2],.true.)
+    handles(2)=resident_flow%bind_real64(V,[-2,-2,-2],.true.)
+    handles(3)=resident_flow%bind_real64(W,[-2,-2,-2],.true.)
+    handle=resident_flow%bind_real64(cfl_values,[1,1,1],.false.,persistent=.true.)
+    {cfl_call}
+    call pressure_require(fort_scope_max_real64_v1(resident_flow%context,handle,3_c_int32_t, &
+      size(cfl_values,kind=c_size_t),0._c_double,maximum,any_nan,report))
+    nan=any_nan/=0
+  end subroutine
+  subroutine ResidentAverage(source,average,source_lower,average_lower,offset,weight)
+    real(c_double), contiguous, target, intent(in) :: source(:,:,:)
+    real(c_double), contiguous, target, intent(inout) :: average(:,:,:)
+    integer, intent(in) :: source_lower(3),average_lower(3),offset(3)
+    real(c_double), intent(in) :: weight
+    integer(c_int64_t) :: source_handle,average_handle
+    if (any(offset<0) .or. any(shape(average)+offset>shape(source))) error stop 'invalid average view'
+    source_handle=resident_flow%bind_real64(source,source_lower,.true.)
+    average_handle=resident_flow%bind_real64(average,average_lower,.true.)
+    {avg_call}
+  end subroutine
+end module
+"""
+
+
+def finalize_before_native(text):
+    """Publish while all fields (including diagnostic RK scratch) still exist."""
+    finalizer = "  block\n    use Pressure, only: FinalizeResidentPressure\n    call FinalizeResidentPressure()\n  end block\n"
+    if "    use Frames_common, only: FinalizeResidentOutput\n" in text:
+        finalizer = finalizer.replace("    use Pressure", "    use Frames_common, only: FinalizeResidentOutput\n    use Pressure")
+        finalizer = finalizer.replace("    call FinalizeResidentPressure()", "    call FinalizeResidentOutput()\n    call FinalizeResidentPressure()")
+    _once(text, finalizer)
+    text = text.replace(finalizer, "")
+    diagnostic = "  block\n    use Dynamics, only: comparison_U2 => U2"
+    anchor = diagnostic if diagnostic in text else "  call Dynamics_Deallocate"
+    position = _once(text, anchor)
+    return text[:position] + finalizer + text[position:]
+
+
+def integrate_time_loop(integration, configured, entries, directory):
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    sources = {Path(r["path"]).name: Path(r["path"]).read_text() for r in integration["sources"]}
+    originals = {Path(r["original"]["path"]).name: Path(r["prepared"]["path"]) for r in configured["sources"]}
+    cut = "\n    if (resident_flow%joined) then\n      call resident_flow%end_epoch()\n      resident_flow%joined=.false.\n    endif\n"
+    _once(sources["tsteps.f90"], cut)
+    sources["tsteps.f90"] = sources["tsteps.f90"].replace(cut, "\n")
+
+    # First-step setup remains native. Subsequent reached CFL work sees the
+    # same domain as RK and output, including swapped physical allocations.
+    text = sources["dynamics.f90"]
+    lo, hi = _routine(text, "TimeStepLength")
+    body = text[lo:hi]
+    anchor = "    subroutine get_U_dx_max\n"
+    _once(body, anchor)
+    body = body.replace(anchor, anchor + """      use elmm_resident_pressure_state, only: resident_flow
+      use elmm_resident_time_tasks, only: ResidentCFL
+      if (resident_flow%active) then
+        if (gridtype/=GRID_UNIFORM) error stop 'resident CFL requires uniform grid'
+        call ResidentCFL(U,V,W,Prnx,Prny,Prnz,dxmin,dymin,dzmin,U_dx_max,nan)
+        return
+      endif
+""")
+    sources["dynamics.f90"] = text[:lo] + body + text[hi:]
+
+    text = originals["outputs.f90"].read_text()
+    lo, hi = _routine(text, "OutTStep")
+    body = text[lo:hi]
+    anchor = "    use Wallmodels, only: ComputeViscsWM\n"
+    _once(body, anchor)
+    body = body.replace(anchor, anchor + "    use elmm_resident_pressure_state, only: resident_flow\n"
+                        "    use elmm_resident_time_tasks, only: ResidentAverage\n")
+    anchor = "    if (.not.called) then"
+    pos = _once(body, anchor)
+    body = body[:pos] + """    if (resident_flow%active) then
+      if (size(probes)>0 .or. enable_profiles .or. store%probes_fluxes==1 .or. &
+          store%tke==1 .or. store%avg_UU_prime>0 .or. Btype(To)==BC_AUTOMATIC_FLUX .or. &
+          enable_buoyancy .or. enable_moisture .or. num_of_scalars>0) then
+        call resident_flow%end_epoch()
+        resident_flow%joined=.false.
+      endif
+    endif
+
+""" + body[pos:]
+    for field, offset in (("U", "0,0,0"), ("V", "0,0,0"), ("W", "0,0,0"), ("Pr", "2,2,2")):
+        original = f"{field}_avg = {field}_avg + {field}" + ("(1:Prnx,1:Prny,1:Prnz)" if field == "Pr" else "") + " * time_weight"
+        _once(body, original)
+        body = body.replace(original, f"""if (resident_flow%active) then
+          call ResidentAverage({field},{field}_avg,lbound({field}),lbound({field}_avg),[{offset}],time_weight)
+        else
+          {original}
+        endif""")
+    sources["outputs.f90"] = text[:lo] + body + text[hi:]
+
+    text = originals["frames_common.f90"].read_text()
+    anchor = "        call D%Fill(U, V, W, Pr, Viscosity, Temperature, Moisture, Scalar)"
+    pos = _once(text, anchor)
+    text = text[:pos] + """        block
+          use, intrinsic :: iso_c_binding
+          use elmm_resident_pressure_state, only: resident_flow
+          integer(c_int64_t) :: frame_reads(5)
+          if (resident_flow%active) then
+            frame_reads(1)=resident_flow%bind_real64(U,lbound(U),.true.)
+            frame_reads(2)=resident_flow%bind_real64(V,lbound(V),.true.)
+            frame_reads(3)=resident_flow%bind_real64(W,lbound(W),.true.)
+            frame_reads(4)=resident_flow%bind_real64(Pr,lbound(Pr),.true.)
+            frame_reads(5)=resident_flow%bind_real64(Viscosity,lbound(Viscosity),.true.)
+            call resident_flow%observe(frame_reads)
+          endif
+        end block
+""" + text[pos:]
+    sources["frames_common.f90"] = text
+    # Their derived-type bindings import the changed frame declaration.
+    for name in ("vtkframes.f90", "frames.f90", "surfacemapframes.f90"):
+        sources[name] = originals[name].read_text()
+    sources["main.f90"] = finalize_before_native(sources["main.f90"])
+    from .resident_output import asynchronous_frames
+    sources["frames_common.f90"], sources["vtkframes.f90"], sources["main.f90"] = asynchronous_frames(
+        sources["frames_common.f90"], sources["vtkframes.f90"], sources["main.f90"])
+    sources["resident_time_tasks.f90"] = _tasks(entries)
+    records = []
+    for name, text in sources.items():
+        path = directory / name
+        path.write_text(addressable_arrays(text))
+        records.append(identity(path))
+    result = {"version": 1, "sources": records, "basis": integration,
+              "epoch": "primary adaptive time loop; native output fallback closes before access",
+              "publication": "two immutable VTK snapshot slots; unsupported frames read only; writer join before field dumps and deallocation",
+              "gpu_execution_established": False}
+    (directory / "time-integration.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
diff --git a/elmm_pipeline/resident_walls.py b/elmm_pipeline/resident_walls.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b43e735b8ad4e2e0a089f1ca451642a6f913807
--- /dev/null
+++ b/elmm_pipeline/resident_walls.py
@@ -0,0 +1,560 @@
+"""Primary planar-wall source adapter over compiler-generated numerical entries.
+
+The packed planes are ordinary Fortran allocations registered with the existing
+domain. They contain wall state, not replica/coherence metadata. Coordinates are
+validated as complete, unique rectangular planes before replacing indirect loops.
+"""
+from pathlib import Path
+import hashlib
+import json
+import re
+
+from .gpu_hot_path import _once, _routine
+from .resident_rk import identity, addressable_arrays
+
+
+def _verify_wall_helpers(source):
+    # The scalarized iteration is deliberately tied to these source helpers.
+    # Changed physics must be reviewed, never silently replaced by old kernels.
+    expected = {
+        "WMFlatUstar": "899164d70d3da811ca38ec02d4f178b9d541d5ddeaab59ce54c15586d171f9d0",
+        "WMFlatStress": "16552282a85dbaabb79540efd04db4d394009f1c7158d0ade6c63578c600b507",
+        "WMFlatVisc": "7b10bc27cb5dcadb54748be35702604b7cbadd64210491f80ec547291f88f5b2",
+        "vel_and_dist": "8a06c7892cfee6f431599d544b8eecc645478f1ba8ece061ed655451dd077f50",
+        "ComputeViscsWM": "ca4bbbb1446b5d5dc6a270eb2a128ea20c336bd982867d8cf030aa67102ccdb0",
+        "ComputeUVWFluxesWM": "1efb293f47edd0a7f2f5441f1a3907afadedcc5852fc823292a8c4eee9939b71",
+    }
+    for name, digest in expected.items():
+        routine = re.search(r"(?ims)^\s*(?:pure\s+)?subroutine " + name +
+                            r"\(.*?^\s*end subroutine[^\n]*", source)
+        if routine is None:
+            raise ValueError("Missing original wall helper: " + name)
+        canonical = re.sub(r"\s+", "", re.sub(r"!.*", "", routine[0])).lower()
+        if hashlib.sha256(canonical.encode()).hexdigest() != digest:
+            raise ValueError("Wall helper changed; requalify the scalarization: " + name)
+    return expected
+
+
+def _norm3(result, values):
+    """The pinned GNU Fortran NORM2 lowering, including scaling and order."""
+    lines = ["norm_scale=1._8", "norm_value=0._8"]
+    for value in values:
+        lines += [f"if ({value}/=0._8) then", f"  norm_abs=abs({value})",
+                  "  if (norm_abs>norm_scale) then", "    norm_ratio=norm_scale/norm_abs",
+                  "    norm_value=(norm_ratio*norm_ratio)*norm_value+1._8", "    norm_scale=norm_abs",
+                  "  else", "    norm_ratio=norm_abs/norm_scale",
+                  "    norm_value=norm_ratio*norm_ratio+norm_value", "  endif", "endif"]
+    return "\n".join(lines + [f"{result}=sqrt(norm_value)*norm_scale"])
+
+
+def _shift_arrays(text, arrays):
+    for name, shift in arrays.items():
+        # Prepared scalar coordinates have no nested function calls.
+        pattern = r"\b" + name + r"\(([^()]*)\)"
+        def shifted(match):
+            args = match[1].split(",")
+            if len(args) != 3:
+                raise ValueError("Unexpected wall array reference: " + match[0])
+            return name + "(" + ",".join("(" + a.strip() + ")+" + str(shift) for a in args) + ")"
+        text = re.sub(pattern, shifted, text, flags=re.I)
+    return text
+
+
+def _stress_source(original, component):
+    if component == 0:
+        velocities = """v1=(U(i,j,k)+U(i-1,j,k))/2._8
+v2=(V(i,j,k)+V(i,j-1,k))/2._8
+v3=(W(i,j,k)+W(i,j,k-1))/2._8"""
+    else:
+        start = re.search(r"(?im)^\s*(?:pure\s+)?function local_velocity\(", original)
+        if start is None:
+            raise ValueError("Missing original wall velocity interpolation")
+        body = original[start.start():]
+        body = body[:body.lower().index("  end function")]
+        start = f"      case ({component})" if component < 3 else "      case default"
+        body = body[body.index(start) + len(start):]
+        stop = re.search(r"(?im)^\s*(case\b|end select)", body)
+        velocities = body[:stop.start()]
+        for old, new in (("xi", "i"), ("yj", "j"), ("zk", "k")):
+            velocities = re.sub(r"\b" + old + r"\b", new, velocities, flags=re.I)
+        velocities = re.sub(r"vel\((\d)\)", r"v\1", velocities, flags=re.I).replace("_knd", "_8")
+    velocities = _shift_arrays(velocities, dict(U=3, V=3, W=3))
+    # A bounded active flag preserves the original convergence/50-iteration
+    # ordering while keeping the point loop expressible by ordinary lowering.
+    flux = "" if component == 0 else f"""
+{_norm3('mag', ('v1', 'v2', 'v3'))}
+if (mag>sqrt(epsilon(1._8))) then
+  fval=(v{component}/mag)*star**2*reciprocal
+  if (direction==5) fval=-fval
+else
+  fval=0
+endif
+flux(i,j)=fval
+"""
+    args = "u,v,w,ustar," + ("flux," if component else "") + "nx,ny,k,distance_z,viscosity" + (",reciprocal,direction" if component else "")
+    return f"""module resident_wall_stress_{component}
+implicit none
+contains
+subroutine stress({args})
+real(8), intent(in) :: u(:,:,:),v(:,:,:),w(:,:,:)
+real(8), intent(inout) :: ustar(:,:)
+{"real(8), intent(out) :: flux(:,:)" if component else ""}
+integer, value, intent(in) :: nx,ny,k
+real(8), value, intent(in) :: distance_z,viscosity
+{"real(8), value, intent(in) :: reciprocal" if component else ""}
+{"integer, value, intent(in) :: direction" if component else ""}
+integer :: i,j,iteration,done
+real(8) :: v1,v2,v3,dot,dist,vel,mag,star,star2,lam,zpl,fval
+real(8) :: norm_scale,norm_value,norm_ratio,norm_abs
+do j=1,ny
+ do i=1,nx
+  {velocities}
+  {_norm3('dist', ('0._8', '0._8', 'distance_z'))}
+  v1=v1-0._8
+  v2=v2-0._8
+  v3=v3-0._8
+  dot=((0._8+v1*0._8)+v2*0._8)+v3*distance_z
+  v1=v1-dot*0._8/dist**2
+  v2=v2-dot*0._8/dist**2
+  v3=v3-dot*distance_z/dist**2
+  {_norm3('vel', ('v1', 'v2', 'v3'))}
+  star=ustar(i,j)
+  if (vel/=0) then
+    lam=sqrt(viscosity*vel/dist)
+    if (dist*lam/viscosity<5._8) then
+      star=lam
+    else
+      done=0
+      do iteration=1,50
+        if (done==0) then
+          star2=star
+          zpl=dist*star2/viscosity
+          if (zpl<=5._8) then
+            star=sqrt(viscosity*vel/dist)
+          else if (zpl<30._8) then
+            star=vel/(5*log(zpl)-3.05)
+          else
+            star=vel/(log(zpl)/0.4_8+5.5_8)
+          endif
+          if (abs(star-star2)/abs(star)<1e-4_8) then
+            done=1
+          else if (iteration>=50) then
+            star=0
+            done=1
+          endif
+        endif
+      enddo
+    endif
+  endif
+  if (star<0) star=0
+  ustar(i,j)=star
+  {flux}
+ enddo
+enddo
+end subroutine
+end module
+"""
+
+
+def _corrections(integration):
+    text = next(Path(r["path"]).read_text() for r in integration["sources"] if Path(r["path"]).name == "momentum_diffusion.f90")
+    lo, hi = _routine(text, "MomentumDiffusion_nobranch_2ord")
+    body = text[lo:hi]
+    pattern = r"(?ms)^    block\n(?:(?!^    end block).)*?wall_handles\(3\)(?:(?!^    end block).)*?^    end block\n"
+    groups = {}
+    for match in re.finditer(pattern, body):
+        block = match[0]
+        point = re.search(r"do i = 1, size\(([UVW][xyz][mp]WMpoints)\)", block, re.I)[1]
+        begin = re.search(r"(?im)^\s*do i = 1, size\(", block).end()
+        begin = block.index("\n", begin) + 1
+        end = block.index("      end do", begin)
+        groups.setdefault(point.lower(), []).append({"block": block, "statements": block[begin:end]})
+    if len(groups) != 18 or any(len(v) != 2 for v in groups.values()):
+        raise ValueError("Unexpected wall correction topology")
+    return groups
+
+
+def generate_wall_entries(integration, compiler_root, python, directory):
+    from .local_adapter import transform
+
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    wall = next(r for r in integration["sources"] if Path(r["path"]).name == "wallmodels.f90")
+    original = Path(wall["path"]).read_text()
+    helpers = _verify_wall_helpers(original)
+    sources = {"stress" + str(c): (_stress_source(original, c), f"resident_wall_stress_{c}::stress") for c in range(4)}
+    groups = _corrections(integration)
+    for component, letter in enumerate("uvw", 1):
+        for side in "mp":
+            point = letter + "z" + side + "wmpoints"
+            statements = "\n".join(v["statements"] for v in groups[point])
+            for field, coordinate in (("xi", "i"), ("yj", "j"), ("zk", "k")):
+                statements = re.sub(point + r"\(i\)%" + field, coordinate, statements, flags=re.I)
+            statements = re.sub(point + r"\(i\)%fluxp", "flux(i,j)", statements, flags=re.I)
+            # Remove redundant parentheses from the generated include's affine
+            # coordinates before physical-origin normalization.
+            statements = re.sub(r"\(([ijk](?:[+-]\d+)?)\)", r"\1", statements, flags=re.I)
+            statements = re.sub(r"\b" + letter + "2" + r"\b", "result", statements, flags=re.I)
+            statements = re.sub(r"\b" + letter + r"\b", "velocity", statements, flags=re.I)
+            statements = _shift_arrays(statements, dict(result=3, velocity=3, nu=2))
+            name = "correction" + str(component) + side
+            source = f"""module resident_wall_{name}
+implicit none
+contains
+subroutine correction(result,velocity,nu,flux,nx,ny,k,recdzmin2)
+real(8), intent(inout) :: result(:,:,:)
+real(8), intent(in) :: velocity(:,:,:),nu(:,:,:),flux(:,:)
+integer, value, intent(in) :: nx,ny,k
+real(8), value, intent(in) :: recdzmin2
+integer :: i,j
+do j=1,ny
+ do i=1,nx
+{statements.replace('_knd', '_8')}
+ enddo
+enddo
+end subroutine
+end module
+"""
+            sources[name] = (source, f"resident_wall_{name}::correction")
+    result = {"version": 1, "original_wall": wall, "helper_contract": helpers,
+              "norm_lowering": "pinned GNU Fortran 15 scaled NORM2, accumulation order preserved",
+              "entries": {}, "correction_groups": groups}
+    for name, (source, entry) in sources.items():
+        path = directory / (name + ".f90")
+        path.write_text(source)
+        target = directory / (name + "-entry")
+        transformed = transform(path, Path(compiler_root), Path(python), target, entry=entry,
+                                gpu_options={"gpu_policy": "sections", "memory_model": "scoped",
+                                             "scope_transfers": "direct", "host_threads": 4})
+        shared = transformed["shared_entry"]
+        if not shared["region_execution"] or not all(r["gpu_available"] for r in shared["region_execution"]):
+            raise ValueError("Wall numerical entry lacks GPU execution: " + name)
+        result["entries"][name] = {"source": identity(path), "directory": str(target), "entry": shared}
+        (directory / "wall-entries.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def _driver(entries):
+    uses, dispatch_stress, dispatch_correction = [], [], []
+    for name, item in entries["entries"].items():
+        entry = item["entry"]
+        uses.append("    use " + entry["fortran_module"] + ", only: " + name + "_run=>run")
+        if name.startswith("stress"):
+            component = int(name[-1])
+            actual = dict(u="handles(1)", v="handles(2)", w="handles(3)", ustar="star_handle",
+                          flux="flux_handle", nx="p%nx", ny="p%ny", k="p%k", distance_z="p%distz",
+                          viscosity="molecular_viscosity", reciprocal="1._knd/dzmin", direction="p%direction")
+            target = dispatch_stress
+            case = component
+        else:
+            component, side = int(name[-2]), name[-1]
+            actual = dict(result="handles(1)", velocity="handles(2)", nu="handles(3)", flux="flux_handle",
+                          nx="p%nx", ny="p%ny", k="p%k", recdzmin2="1._knd/dzmin**2")
+            target = dispatch_correction
+            case = component * 10 + (1 if side == "m" else 2)
+        args = ["resident_flow%context", "FORT_SCOPE_GPU"] + [actual[n] for n in entry["argument_order"][2:]]
+        target.append(f"      case({case})\n        call pressure_require({name}_run( &\n          " + ", &\n          ".join(args) + "))")
+    declarations = """
+  type resident_wall_plane
+    integer :: nx=0,ny=0,k=0,direction=0
+    real(knd) :: distz=0
+    integer, allocatable :: record(:,:)
+    real(knd), allocatable :: star(:,:),flux(:,:)
+  end type
+  type(resident_wall_plane), target, save :: resident_planes(2,0:3)
+  integer(kind=8), save :: resident_wall_epoch=-1
+  public :: ResidentWallsPrepare, ResidentPrStress, ResidentUVWStress, ResidentWallCorrection
+  public :: ResidentWallsPublish
+"""
+    procedures = """
+  logical function ResidentWallsPrepare() result(ok)
+    use elmm_resident_pressure_state, only: resident_flow
+    integer :: side,component,q,i,j,k,nx,ny,nz,n(3,3)
+    type(WMPointUVW), pointer :: points(:)
+    ok=.false.
+    if (.not.resident_flow%active) return
+    if (resident_wall_epoch==resident_flow%generation) then
+      ok=.true.
+      return
+    endif
+    if (wallmodeltype/=1 .or. molecular_viscosity<=0 .or. gridtype/=GRID_UNIFORM) return
+    if (enable_buoyancy .or. enable_moisture .or. num_of_scalars>0) return
+    if (.not.allocated(WMPoints)) return
+    if (size(WMPoints)/=2*Prnx*Prny) return
+    if (any(WMPoints%z0>0) .or. any(WMPoints%prescribed_ustar)) return
+    if (any(WMPoints%distx/=0) .or. any(WMPoints%disty/=0)) return
+    if (any(WMPoints%wallu/=0) .or. any(WMPoints%wallv/=0) .or. any(WMPoints%wallw/=0)) return
+    do component=1,3
+      do side=1,4
+        if (.not.associated(WMPointsUVW(side,component)%points)) return
+        if (size(WMPointsUVW(side,component)%points)/=0) return
+      enddo
+    enddo
+    n(:,1)=[Unx,Uny,Unz];n(:,2)=[Vnx,Vny,Vnz];n(:,3)=[Wnx,Wny,Wnz]
+    do component=0,3
+      if (component==0) then
+        nx=Prnx;ny=Prny;nz=Prnz
+      else
+        nx=n(1,component);ny=n(2,component);nz=n(3,component)
+      endif
+      do side=1,2
+        associate(p=>resident_planes(side,component))
+          if (allocated(p%star)) deallocate(p%star,p%flux,p%record)
+          p%nx=nx;p%ny=ny;p%k=merge(1,nz,side==1);p%direction=side+4
+          allocate(p%star(nx,ny),p%flux(nx,ny),p%record(nx,ny))
+          p%record=0;p%star=0;p%flux=0
+          if (component==0) then
+            do q=1,size(WMPoints)
+              if (WMPoints(q)%zk/=p%k) cycle
+              i=WMPoints(q)%xi;j=WMPoints(q)%yj
+              if (i<1.or.i>nx.or.j<1.or.j>ny) return
+              if (p%record(i,j)/=0) return
+              p%record(i,j)=q;p%star(i,j)=WMPoints(q)%ustar
+              p%distz=WMPoints(q)%distz
+            enddo
+            if (any(p%record==0) .or. p%distz==0) return
+            do j=1,ny
+              do i=1,nx
+                if (WMPoints(p%record(i,j))%distz/=p%distz) return
+              enddo
+            enddo
+          else
+            if (.not.associated(WMPointsUVW(side+4,component)%points)) return
+            points=>WMPointsUVW(side+4,component)%points
+            if (size(points)==0) then
+              p%nx=0;p%ny=0
+              cycle
+            endif
+            if (size(points)/=nx*ny) return
+            if (any(points%z0>0) .or. any(points%prescribed_ustar)) return
+            if (any(points%distx/=0) .or. any(points%disty/=0)) return
+            if (any(points%wallu/=0) .or. any(points%wallv/=0) .or. any(points%wallw/=0)) return
+            p%distz=points(1)%distz
+            if (p%distz==0.or.any(points%distz/=p%distz).or.any(points%zk/=p%k)) return
+            do q=1,size(points)
+              i=points(q)%xi;j=points(q)%yj
+              if (i<1.or.i>nx.or.j<1.or.j>ny) return
+              if (p%record(i,j)/=0) return
+              p%record(i,j)=q;p%star(i,j)=points(q)%ustar;p%flux(i,j)=points(q)%fluxp
+            enddo
+            if (any(p%record==0)) return
+          endif
+        end associate
+      enddo
+    enddo
+    resident_wall_epoch=resident_flow%generation
+    ok=.true.
+  end function
+
+  subroutine ResidentPrStress(U,V,W)
+    real(knd),contiguous,target,intent(in) :: U(-2:,-2:,-2:),V(-2:,-2:,-2:),W(-2:,-2:,-2:)
+    call ResidentWallStress(U,V,W,0)
+  end subroutine
+
+  subroutine ResidentUVWStress(U,V,W)
+    real(knd),contiguous,target,intent(in) :: U(-2:,-2:,-2:),V(-2:,-2:,-2:),W(-2:,-2:,-2:)
+    integer :: component
+    do component=1,3
+      call ResidentWallStress(U,V,W,component)
+    enddo
+  end subroutine
+
+  subroutine ResidentWallStress(U,V,W,component)
+    use, intrinsic :: iso_c_binding
+    use fort_scoped_memory, only: FORT_SCOPE_GPU
+    use elmm_resident_pressure_state, only: resident_flow,pressure_require
+@USES@
+    real(knd),contiguous,target,intent(in) :: U(-2:,-2:,-2:),V(-2:,-2:,-2:),W(-2:,-2:,-2:)
+    integer,intent(in) :: component
+    integer(c_int64_t) :: handles(3),star_handle,flux_handle
+    integer :: side
+    if (resident_wall_epoch/=resident_flow%generation) error stop 'wall epoch not prepared'
+    handles(1)=resident_flow%bind_real64(U,lbound(U),.true.)
+    handles(2)=resident_flow%bind_real64(V,lbound(V),.true.)
+    handles(3)=resident_flow%bind_real64(W,lbound(W),.true.)
+    do side=1,2
+      associate(p=>resident_planes(side,component))
+        if (p%nx==0) cycle
+        star_handle=resident_flow%bind_real64(p%star,[1,1],.true.)
+        flux_handle=0
+        if (component>0) flux_handle=resident_flow%bind_real64(p%flux,[1,1],.false.)
+        select case(component)
+@STRESS@
+        end select
+      end associate
+    enddo
+  end subroutine
+
+  subroutine ResidentWallCorrection(result,velocity,nu,component,side)
+    use, intrinsic :: iso_c_binding
+    use fort_scoped_memory, only: FORT_SCOPE_GPU
+    use elmm_resident_pressure_state, only: resident_flow,pressure_require
+@USES@
+    real(knd),contiguous,target,intent(inout) :: result(-2:,-2:,-2:)
+    real(knd),contiguous,target,intent(in) :: velocity(-2:,-2:,-2:),nu(-1:,-1:,-1:)
+    integer,intent(in) :: component,side
+    integer(c_int64_t) :: handles(3),flux_handle
+    if (resident_wall_epoch/=resident_flow%generation) error stop 'wall correction outside prepared epoch'
+    associate(p=>resident_planes(side,component))
+      if (p%nx==0) return
+      handles(1)=resident_flow%bind_real64(result,lbound(result),.true.)
+      handles(2)=resident_flow%bind_real64(velocity,lbound(velocity),.true.)
+      handles(3)=resident_flow%bind_real64(nu,lbound(nu),.true.)
+      flux_handle=resident_flow%bind_real64(p%flux,[1,1],.false.)
+      select case(component*10+side)
+@CORRECTION@
+      end select
+    end associate
+  end subroutine
+
+  subroutine ResidentWallsPublish(diagnostics_only)
+    use, intrinsic :: iso_c_binding
+    use elmm_resident_pressure_state, only: resident_flow
+    logical,optional,intent(in) :: diagnostics_only
+    logical :: diagnostics
+    integer :: side,component,i,j,q,last_side,last_component
+    integer(c_int64_t) :: handle
+    type(WMPointUVW),pointer :: points(:)
+    if (.not.resident_flow%active.or.resident_wall_epoch/=resident_flow%generation) return
+    diagnostics=.false.
+    if (present(diagnostics_only)) diagnostics=diagnostics_only
+    last_side=2;last_component=3
+    if (diagnostics) then
+      last_side=1;last_component=2
+    endif
+    do component=0,last_component
+      do side=1,last_side
+        associate(p=>resident_planes(side,component))
+          if (p%nx==0) cycle
+          handle=resident_flow%bind_real64(p%star,[1,1],.true.)
+          call resident_flow%observe([handle])
+          if (component==0) then
+            do j=1,p%ny
+              do i=1,p%nx
+                WMPoints(p%record(i,j))%ustar=p%star(i,j)
+              enddo
+            enddo
+          else
+            points=>WMPointsUVW(side+4,component)%points
+            if (.not.diagnostics) then
+              handle=resident_flow%bind_real64(p%flux,[1,1],.false.)
+              call resident_flow%observe([handle])
+            endif
+            do j=1,p%ny
+              do i=1,p%nx
+                q=p%record(i,j);points(q)%ustar=p%star(i,j)
+                if (.not.diagnostics) then
+                  points(q)%fluxp=p%flux(i,j);points(q)%fluxm=p%flux(i,j)
+                endif
+              enddo
+            enddo
+          endif
+        end associate
+      enddo
+    enddo
+  end subroutine
+"""
+    return declarations, procedures.replace("@USES@", "\n".join(uses)).replace("@STRESS@", "\n".join(dispatch_stress)).replace("@CORRECTION@", "\n".join(dispatch_correction))
+
+
+def integrate_wall_entries(integration, entries, directory):
+    directory = Path(directory).resolve()
+    directory.mkdir(parents=True, exist_ok=False)
+    sources = {Path(r["path"]).name: Path(r["path"]).read_text() for r in integration["sources"]}
+    declarations, procedures = _driver(entries)
+    wall = sources["wallmodels.f90"]
+    start = re.search(r"(?im)^module Wallmodels\b", wall).start()
+    contains = re.search(r"(?im)^contains\s*$", wall[start:]).start() + start
+    wall = wall[:contains] + declarations + wall[contains:]
+    end = re.search(r"(?im)^\s*end module Wallmodels\b", wall)
+    if end is None:
+        raise ValueError("Missing wall model module end")
+    wall = wall[:end.start()] + procedures + wall[end.start():]
+    for name, anchor in (("GroundUstar", "    if (offset_to_global_z==0) then"),
+                         ("GroundUstarUVW", "    if (any(WMPoints%zk == 1)) then")):
+        start = re.search(r"(?im)^\s*real\(knd\) function " + name + r"\(", wall).start()
+        pos = wall.index(anchor, start)
+        wall = wall[:pos] + "    call ResidentWallsPublish(.true.)\n" + wall[pos:]
+    sources["wallmodels.f90"] = wall
+
+    text = sources["dynamics.f90"]
+    lo, hi = _routine(text, "SubgridStresses")
+    body = text[lo:hi]
+    # Replace the prior whole-field observation and native viscosity transaction
+    # together. Primary Sigma SGS overwrites every interior viscosity value.
+    start = body.index("    block\n      use, intrinsic :: iso_c_binding")
+    stop = body.index("    call SubgridModel(U,V,W)", start)
+    old = body[start:stop]
+    # Retain the old path verbatim for unsupported configurations.
+    new = """    block
+      use elmm_resident_pressure_state, only: resident_flow
+      if (resident_flow%active) then
+        if (.not.ResidentWallsPrepare()) then
+          call ResidentWallsPublish()
+          call resident_flow%end_epoch()
+          resident_flow%joined=.false.
+        endif
+      endif
+      if (resident_flow%active) then
+        call ResidentPrStress(U,V,W)
+      else
+@OLD@
+      endif
+    end block
+
+""".replace("@OLD@", old.rstrip())
+    body = body[:start] + new + body[stop:]
+    anchor = "                    call ComputeUVWFluxesWM(U, V, W, Pr, Temperature, Moisture)"
+    _once(body, anchor)
+    body = body.replace(anchor, """      block
+        use elmm_resident_pressure_state, only: resident_flow
+        if (resident_flow%active) then
+          call ResidentUVWStress(U,V,W)
+        else
+          call ComputeUVWFluxesWM(U,V,W,Pr,Temperature,Moisture)
+        endif
+      end block""")
+    sources["dynamics.f90"] = text[:lo] + body + text[hi:]
+
+    text = sources["momentum_diffusion.f90"]
+    for point, group in entries["correction_groups"].items():
+        component = "uvw".index(point[0]) + 1
+        for index, record in enumerate(group):
+            block = record["block"]
+            _once(text, block)
+            call = ""
+            if point[1] == "z" and index == 0:
+                side = 1 if point[2] == "m" else 2
+                field = point[0].upper()
+                call = f"        call ResidentWallCorrection({field}2,{field},nu,{component},{side})\n"
+            # The validated primary topology has no x/y wall records. The two
+            # z correction loops are fused per plane, without changing either
+            # point's accumulation order or the ordering between planes.
+            replacement = "    block\n      use elmm_resident_pressure_state, only: resident_flow\n      if (resident_flow%active) then\n" + call + "      else\n" + block + "      endif\n    end block\n"
+            text = text.replace(block, replacement)
+    sources["momentum_diffusion.f90"] = text
+
+    text = sources["outputs.f90"]
+    anchor = "    use Wallmodels, only: ComputeViscsWM\n"
+    _once(text, anchor)
+    text = text.replace(anchor, "    use Wallmodels, only: ComputeViscsWM, ResidentWallsPublish\n")
+    anchor = "        call resident_flow%end_epoch()"
+    _once(text, anchor)
+    text = text.replace(anchor, "        call ResidentWallsPublish()\n" + anchor)
+    sources["outputs.f90"] = text
+    text = sources["pressure.f90"]
+    anchor = "  subroutine FinalizeResidentPressure()\n"
+    _once(text, anchor)
+    sources["pressure.f90"] = text.replace(anchor, anchor +
+        "    use Wallmodels, only: ResidentWallsPublish\n    call ResidentWallsPublish()\n")
+    records = []
+    for name, text in sources.items():
+        path = directory / name
+        path.write_text(addressable_arrays(text))
+        records.append(identity(path))
+    result = {"version": 1, "sources": records, "basis": integration,
+              "wall_contract": "uniform flat stationary complete z planes; checked topology; no x/y wall records",
+              "dead_store": "pre-SGS point viscosity overwritten at every interior cell by primary Sigma SGS",
+              "gpu_execution_established": False}
+    (directory / "wall-integration.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
