-bool private_file(int fd, struct stat &s) {
-  return fd >= 0 && fstat(fd, &s) == 0 && S_ISREG(s.st_mode) &&
-         s.st_uid == geteuid() && !(s.st_mode & 0077) && s.st_nlink == 1;
