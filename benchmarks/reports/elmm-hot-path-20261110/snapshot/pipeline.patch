-std::string hex(const Digest &value) {
-  static constexpr char alphabet[] = "0123456789abcdef";
-  std::string result;
-  result.reserve(64);
-  for (auto byte : value) {
-    result.push_back(alphabet[byte >> 4]);
-    result.push_back(alphabet[byte & 15]);
-  }
-  return result;
