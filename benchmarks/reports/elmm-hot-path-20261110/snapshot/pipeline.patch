-template <std::floating_point T, std::size_t Dim>
-struct MpiFftPolicy {
-public:
-    using Plan = HeFFTePlan<T>;
-
-    static auto Init(GridSizes<Dim> ns,
-                     GridSizes<Dim> pencil_sizes,
-                     GridSizes<Dim> slab_sizes,
-                     MPI_Comm comm,
