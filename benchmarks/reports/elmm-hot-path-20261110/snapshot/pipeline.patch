-template <std::floating_point T>
-void RunApisNonuniformZ(std::span<T> phi,
-                        std::span<const T> rhs,
-                        const NonuniformZSolverConfig<T> &cfg,
-                        const IApproximation<T> &approx,
-                        Approximation c_approx,
