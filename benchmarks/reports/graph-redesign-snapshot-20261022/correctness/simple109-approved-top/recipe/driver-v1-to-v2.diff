+def checked_historical_plan(build, stage):
+    # Original modules/stages stay byte-exact; this explicit sidecar resolves only
+    # the approved parser-path change, without modifying their functions.
+    if digest(build.PLAN) != build.PLAN_SHA256:
+        raise RuntimeError('reviewed original plan changed')
+    original_stage = read(build.STAGE)
+    if original_stage['plan'] != {'path': str(build.PLAN), 'sha256': build.PLAN_SHA256}:
+        raise RuntimeError('original script stage belongs to another plan')
+    build.verify_hashes(original_stage['script_files_sha256'])
+    build.verify_hashes(historical_helper_projection(original_stage['validation_helpers_sha256'], stage))
+    return read(build.PLAN), original_stage
