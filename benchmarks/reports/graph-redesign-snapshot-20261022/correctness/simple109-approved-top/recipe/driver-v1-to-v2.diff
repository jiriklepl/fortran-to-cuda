+def historical_helper_projection(bindings, stage):
+    """Resolve one reviewed historical parser preimage; every other guard is unchanged."""
+    policy = stage['historical_helper_compatibility']
+    current = '/home/jirka/research/fortran-abomination/elmm-pipeline/elmm_pipeline/gpu_validation.py'
+    old_sha = '8e1cf21aff1ae868f02082ef077fee225cb4626a682ae8f6c408ca84381756cf'
+    new_sha = '1fa37f95456d1779477214a413264b6112950f21e1129ef2fc9574f58ee66479'
+    if (policy['current']['path'] != current or policy['current']['sha256'] != new_sha
+            or policy['historical_preimage']['sha256'] != old_sha):
+        raise RuntimeError('unexpected historical validator compatibility identity')
+    if digest(current) != new_sha or digest(policy['historical_preimage']['path']) != old_sha:
+        raise RuntimeError('approved current parser or retained historical parser changed')
+    result = dict(bindings)
+    if current in result:
+        if result[current] != old_sha:
+            raise RuntimeError('historical helper binding is not the exact reviewed preimage')
+        result[current] = new_sha
+        result[policy['historical_preimage']['path']] = old_sha
+    return result
