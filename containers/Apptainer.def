Bootstrap: docker
From: nvidia/cuda:12.8.1-devel-ubuntu24.04

%files
    requirements.txt /workspace/requirements.txt
    compiler /workspace/compiler
    benchmarks /workspace/benchmarks
    elmm-pipeline /workspace/elmm-pipeline
    containers /workspace/containers

%post
    bash /workspace/containers/install.sh
    # Direct builds should use a clean source checkout, never a results archive.
    rm -rf /workspace/benchmarks/results /workspace/benchmarks/bin \
        /workspace/elmm-pipeline/.cache /workspace/elmm-pipeline/work \
        /workspace/elmm-pipeline/results /workspace/elmm-pipeline/.git
    mkdir -p /output

%environment
    export LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
    export PATH=/opt/venv/bin:/usr/local/cuda/bin:$PATH
    export FC=gfortran-15 CC=gcc-14 CXX=g++-14 CUDAHOSTCXX=/usr/bin/g++-14

%runscript
    exec /workspace/containers/entrypoint.sh "$@"

%help
    doctor: inspect tools, selected GPU and effective memory/CPU budget.
    prepare: fetch pinned application sources and private tools in writable work.
    run-elmm --case channel-simple|channel: fresh native versus scoped SGS CUDA.
    reproduce-plots --snapshot FILE: redraw explicit saved measurements.
    Bind persistent output/work directories; see containers/README.md.
