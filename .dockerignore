# Ignore version control and virtual environments
.git/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
**/*/__pycache__/

# Ignore intermediate build artifacts and object files
*.o
*.mod
*.a
*.so
*.out
*.log
benchmarks/bin/
out/

# Ignore large raw simulation output fields (VTK / HDF5 / raw binaries)
**/*.vtk
**/*.h5
**/*.dat
**/out.vtk
builds.json
**/builds.json

# Mount evidence explicitly; no historical timings or host binaries in images.
benchmarks/results/
elmm-pipeline/.cache/
elmm-pipeline/work/
elmm-pipeline/results/
*.sif
results/
compiler/CODE_MAP.md
compiler/MEMORY_MODEL_PLAN.md
